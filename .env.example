# =============================================================================
# LŪMÉ — Environment Variables Example
# Copy this file to `.env.local` for local development.
# NEVER commit `.env.local` or real secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application (Public & Runtime)
# -----------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=LŪMÉ
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY=EUR
NEXT_PUBLIC_DEFAULT_LOCALE=en

# -----------------------------------------------------------------------------
# MongoDB (Server-only)
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=lume_ecommerce

# -----------------------------------------------------------------------------
# Auth.js (Server-only)
# Generate secret via: npx auth secret  OR  openssl rand -base64 32
# -----------------------------------------------------------------------------
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# -----------------------------------------------------------------------------
# Stripe Payments (Mixed: publishable key is public; secret & webhook are server-only)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# -----------------------------------------------------------------------------
# Cloudinary Media Management (Mixed: cloud name may be public; API secret is server-only)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# Resend Transactional Email (Server-only)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=concierge@example.com

